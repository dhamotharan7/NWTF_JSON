    "Time-resolved Particle Image Velocimetry (PIV)",
    "Pressure-field reconstruction using a pressure Poisson equation"
  ],
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "Streamwise velocity",
      "alternateName": "U"
    },
    {
      "@type": "PropertyValue",
      "name": "Surface-normal velocity",
      "alternateName": "V"
    },
    {
      "@type": "PropertyValue",
      "name": "Pressure",
      "alternateName": "P"
    },
    {
      "@type": "PropertyValue",
      "name": "Freestream velocity",
      "alternateName": "U_inf",
      "value": 0.5366,
      "unitText": "m/s"
    },
    {
      "@type": "PropertyValue",
      "name": "Chord-based Reynolds number",
      "alternateName": "Re_c",
      "value": 71000,
      "unitText": "dimensionless"
    },
    {
      "@type": "PropertyValue",
      "name": "Experimental angle of attack cases",
      "alternateName": "AOA",
      "value": "4, 13, 15",
      "unitText": "degree",
      "description": "The page describes experimental conditions at 4, 13 and 15 degrees. Processed downloadable field datasets listed on this page are provided for 13 and 15 degrees."
    },
    {
      "@type": "PropertyValue",
      "name": "Working fluid",
      "value": "water"
    },
    {
      "@type": "PropertyValue",
      "name": "Kinematic viscosity",
      "alternateName": "nu",
      "value": 1e-06,
      "unitText": "m^2/s"
    },
    {
      "@type": "PropertyValue",
      "name": "Measurement duration per case",
      "value": 26.8,
      "unitText": "s"
    },
    {
      "@type": "PropertyValue",
      "name": "Sampling frequency",
      "value": 1000,
      "unitText": "Hz"
    },
    {
      "@type": "PropertyValue",
      "name": "Dimensionless frequency range",
      "alternateName": "f*",
      "value": "f* <= 3",
      "unitText": "dimensionless"
    },
    {
      "@type": "PropertyValue",
      "name": "High-frequency temporal filter cutoff",
      "value": 10,
      "unitText": "Hz",
      "description": "Velocity fields were temporally filtered to remove mechanical noise above 10 Hz."
    },
    {
      "@type": "PropertyValue",
      "name": "Aerofoil chord length",
      "value": 0.15,
      "unitText": "m"
    },
    {
      "@type": "PropertyValue",
      "name": "Aerofoil total span",
      "value": 0.7,
      "unitText": "m"
    },
    {
      "@type": "PropertyValue",
      "name": "Submerged aerofoil span",
      "value": 0.483,
      "unitText": "m"
    }
  ],
