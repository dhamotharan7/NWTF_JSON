  "@id": "https://dhamotharan7.github.io/NWTF_JSON/#dataset",
  "identifier": "NWTF-AI-TEST-001",
  "version": "2.0",
  "name": "Low-Frequency Dipole Noise Mechanisms in Stalled Aerofoil",
  "url": "https://dhamotharan7.github.io/NWTF_JSON/",
  "sameAs": "https://www.nwtf.ac.uk/dataset/low-frequency-dipole-noise-mechanisms-in-stalled-aerofoil/",
  "mainEntityOfPage": "https://dhamotharan7.github.io/NWTF_JSON/",
  "description": "Experimental aerodynamic dataset for a NACA 0012 aerofoil under stalled conditions. Time-resolved Particle Image Velocimetry measurements are used to reconstruct velocity and pressure fields and investigate low-frequency dipole noise mechanisms. The page provides processed CSV files, CAD geometry, the complete original archive and MATLAB analysis code.",
  "keywords": [
    "aerodynamics",
    "experimental aerodynamics",
    "aeroacoustics",
    "NACA 0012",
    "stalled aerofoil",
    "Particle Image Velocimetry",
    "PIV",
    "pressure reconstruction",
    "dipole noise",
    "fluid mechanics",
    "water flume"
  ],
